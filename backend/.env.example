# ===================================
# AMBIENTE
# ===================================
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
API_VERSION=v1

# ===================================
# BANCO DE DADOS (PostgreSQL)
# ===================================
DATABASE_URL="postgresql://ecommerce_user:changeme_strong_password@localhost:5432/ecommerce_db?schema=public&sslmode=prefer"
DB_POOL_MIN=2
DB_POOL_MAX=10

# ===================================
# REDIS
# ===================================
REDIS_URL="redis://:changeme_redis_password@localhost:6379"
REDIS_TLS=false

# ===================================
# JWT
# ===================================
# Gerar com: openssl rand -hex 64
JWT_ACCESS_SECRET=changeme_jwt_access_secret_at_least_64_chars_long_very_secure_random_string
JWT_REFRESH_SECRET=changeme_jwt_refresh_secret_at_least_64_chars_long_very_secure_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===================================
# COOKIES
# ===================================
COOKIE_SECRET=changeme_cookie_secret_at_least_32_chars_long

# ===================================
# ARGON2ID
# ===================================
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ===================================
# UPLOAD
# ===================================
UPLOAD_MAX_FILE_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp
UPLOAD_DEST=./src/uploads

# ===================================
# RATE LIMIT
# ===================================
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000

# ===================================
# CORS
# ===================================
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# ===================================
# SEGURANÇA
# ===================================
# Gerar com: openssl rand -hex 32
CSRF_SECRET=changeme_csrf_secret_at_least_32_chars
RESET_PASSWORD_SECRET=changeme_reset_password_secret_at_least_32_chars
RESET_PASSWORD_EXPIRES_IN=3600

# ===================================
# EMAIL (mock por padrão)
# ===================================
MAIL_PROVIDER=mock
MAIL_FROM="E-Commerce <noreply@ecommerce.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASS=smtp_password

# ===================================
# APP
# ===================================
APP_NAME="E-Commerce API"
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# ===================================
# LOGS
# ===================================
LOG_LEVEL=debug
LOG_PRETTY=true
